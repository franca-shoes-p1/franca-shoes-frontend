{
  "name": "Radar de Pontos - avisos em tempo real (Telegram)",
  "nodes": [
    {
      "id": "a1",
      "name": "Aviso do site",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "radar-aviso",
      "parameters": {
        "httpMethod": "POST",
        "path": "radar-aviso",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "a2",
      "name": "Conferir senha",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "jsCode": "// Só aceita avisos que trazem a senha do site (a mesma de RADAR_N8N_TOKEN).\nconst TOKEN = 'COLE_AQUI_O_MESMO_VALOR_DE_RADAR_N8N_TOKEN';\nconst item = $input.first().json;\nconst recebido = (item.headers || {})['x-radar-token'] || '';\nif (recebido !== TOKEN) { throw new Error('Senha inválida: aviso recusado'); }\nconst d = item.body || {};\nreturn [{ json: { texto: String(d.texto || '(aviso vazio)') + '\\n\\n👉 https://www.igreja.eco.br/admin/radar' } }];"
      }
    },
    {
      "id": "a3",
      "name": "Responder OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        520,
        -80
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true } }}",
        "options": {}
      }
    },
    {
      "id": "a4",
      "name": "Enviar no Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        520,
        100
      ],
      "parameters": {
        "chatId": "COLE_AQUI_O_ID_DO_SEU_CHAT",
        "text": "={{ $json.texto }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram Radar"
        }
      }
    }
  ],
  "connections": {
    "Aviso do site": {
      "main": [
        [
          {
            "node": "Conferir senha",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Conferir senha": {
      "main": [
        [
          {
            "node": "Responder OK",
            "type": "main",
            "index": 0
          },
          {
            "node": "Enviar no Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}