{
  "name": "Radar de Pontos - busca semanal de locais (Telegram)",
  "nodes": [
    {
      "id": "b1",
      "name": "Toda segunda às 7h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "b2",
      "name": "Cidades e tipos da semana",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "jsCode": "// Troque pela(s) sua(s) cidade(s). Cada cidade roda uma vez por semana, um tipo de local por semana, em rodízio.\nconst CIDADES = [\n  { cidade: 'Belo Horizonte', uf: 'MG' },\n];\nconst RODIZIO = [['academia', 'faculdade'], ['comercio'], ['igreja'], ['terminal']];\nconst semana = Math.floor(Date.now() / (7 * 86400000));\nconst grupos = RODIZIO[semana % RODIZIO.length];\nreturn CIDADES.map((c) => ({ json: { cidade: c.cidade, uf: c.uf, grupos, quantos: 100 } }));"
      }
    },
    {
      "id": "b3",
      "name": "Buscar locais no site",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://www.igreja.eco.br/api/radar/buscar",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-radar-token",
              "value": "COLE_AQUI_O_MESMO_VALOR_DE_RADAR_N8N_TOKEN"
            }
          ]
        },
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ cidade: $json.cidade, uf: $json.uf, grupos: $json.grupos, quantos: $json.quantos }) }}"
      },
      "continueOnFail": true
    },
    {
      "id": "b4",
      "name": "Montar aviso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "jsCode": "const j = $input.first().json || {};\nreturn [{ json: { texto: j.texto || ('⚠️ A busca semanal de locais não funcionou: ' + (j.error && j.error.message || j.erro || 'sem resposta')) } }];"
      }
    },
    {
      "id": "b5",
      "name": "Enviar no Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "chatId": "COLE_AQUI_O_ID_DO_SEU_CHAT",
        "text": "={{ $json.texto }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram Radar"
        }
      }
    }
  ],
  "connections": {
    "Toda segunda às 7h": {
      "main": [
        [
          {
            "node": "Cidades e tipos da semana",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cidades e tipos da semana": {
      "main": [
        [
          {
            "node": "Buscar locais no site",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar locais no site": {
      "main": [
        [
          {
            "node": "Montar aviso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Montar aviso": {
      "main": [
        [
          {
            "node": "Enviar no Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo"
  }
}