{
  "name": "Radar de Pontos - busca semanal de locais (Telegram)",
  "nodes": [
    {
      "id": "b1",
      "name": "Toda segunda às 7h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "b2",
      "name": "Cidades e tipos da semana",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "jsCode": "// Primeira fase: capitais abaixo, começando pelas rodoviárias. Para incluir outra capital, acrescente uma linha.\nconst CIDADES = [\n  { cidade: 'Rio de Janeiro', uf: 'RJ' },\n  { cidade: 'Goiânia', uf: 'GO' },\n  { cidade: 'Curitiba', uf: 'PR' },\n  { cidade: 'Campo Grande', uf: 'MS' },\n  { cidade: 'Vitória', uf: 'ES' },\n  { cidade: 'Salvador', uf: 'BA' },\n  { cidade: 'Florianópolis', uf: 'SC' },\n  { cidade: 'São Paulo', uf: 'SP' },\n  { cidade: 'Belo Horizonte', uf: 'MG' },\n];\n// Rodízio semanal de tipos de local (terminais/rodoviárias sempre entram nas semanas 1 e 4).\nconst RODIZIO = [['terminal', 'comercio'], ['academia', 'faculdade'], ['igreja'], ['terminal']];\nconst semana = Math.floor(Date.now() / (7 * 86400000));\nconst grupos = RODIZIO[semana % RODIZIO.length];\nreturn CIDADES.map((c) => ({ json: { cidade: c.cidade, uf: c.uf, grupos, quantos: 100 } }));"
      }
    },
    {
      "id": "b3",
      "name": "Buscar locais no site",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://www.igreja.eco.br/api/radar/buscar",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-radar-token",
              "value": "COLE_AQUI_O_MESMO_VALOR_DE_RADAR_N8N_TOKEN"
            }
          ]
        },
        "options": {
          "timeout": 60000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 8000
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ cidade: $json.cidade, uf: $json.uf, grupos: $json.grupos, quantos: $json.quantos }) }}"
      },
      "continueOnFail": true
    },
    {
      "id": "b4",
      "name": "Montar aviso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map((it) => { const j = it.json || {}; return { json: { texto: j.texto || ('⚠️ Uma busca semanal de locais não funcionou: ' + ((j.error && j.error.message) || j.erro || 'sem resposta')) } }; });"
      }
    },
    {
      "id": "b5",
      "name": "Enviar no Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "chatId": "COLE_AQUI_O_ID_DO_SEU_CHAT",
        "text": "={{ $json.texto }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram Radar"
        }
      }
    }
  ],
  "connections": {
    "Toda segunda às 7h": {
      "main": [
        [
          {
            "node": "Cidades e tipos da semana",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cidades e tipos da semana": {
      "main": [
        [
          {
            "node": "Buscar locais no site",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar locais no site": {
      "main": [
        [
          {
            "node": "Montar aviso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Montar aviso": {
      "main": [
        [
          {
            "node": "Enviar no Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo"
  }
}