{
 "name": "Fábricas - fila diária 8h (Telegram)",
 "nodes": [
  {
   "id": "r1",
   "name": "Todo dia às 8h",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ],
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 8 * * *"
      }
     ]
    }
   }
  },
  {
   "id": "r2",
   "name": "Pedir resumo da fila",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    260,
    0
   ],
   "parameters": {
    "method": "GET",
    "url": "https://www.igreja.eco.br/api/leads/resumo",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "x-radar-token",
       "value": "COLE_AQUI_O_MESMO_VALOR_DE_RADAR_N8N_TOKEN"
      }
     ]
    },
    "options": {
     "timeout": 60000
    }
   }
  },
  {
   "id": "r3",
   "name": "Enviar no Telegram",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    520,
    0
   ],
   "parameters": {
    "chatId": "COLE_AQUI_O_ID_DO_SEU_CHAT",
    "text": "={{ $json.texto }}",
    "additionalFields": {
     "appendAttribution": false
    }
   },
   "credentials": {
    "telegramApi": {
     "id": "",
     "name": "Telegram Radar"
    }
   }
  }
 ],
 "connections": {
  "Todo dia às 8h": {
   "main": [
    [
     {
      "node": "Pedir resumo da fila",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Pedir resumo da fila": {
   "main": [
    [
     {
      "node": "Enviar no Telegram",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1",
  "timezone": "America/Sao_Paulo"
 }
}